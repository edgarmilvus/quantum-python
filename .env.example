# Quantum Python — the seven variables the live code reads.
# Copy to .env; every script loads it. .env is git-ignored.
#
# IBM: create an API key at https://cloud.ibm.com/iam/apikeys, then copy the
# CRN of the Open Plan instance at https://quantum.cloud.ibm.com/instances
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
QISKIT_IBM_CHANNEL=ibm_quantum_platform

# qBraid: https://account.qbraid.com/ -> Profile -> API keys
QBRAID_API_KEY=

# IonQ: https://cloud.ionq.com/settings/keys
IONQ_API_KEY=

# Chapter 11's provider interface: 1 allows a submission, 0 replays the record.
QUANTUM_LIVE=0
# The interface's ceiling, in dollars.
QUANTUM_MAX_SPEND_USD=5

# Quantum Inspire needs no variable: sign up at https://compute.quantum-inspire.com/
# and run `qi login` once; the token lands in ~/.quantuminspire/config.json.
