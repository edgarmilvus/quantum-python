# Quantum Python — provider credentials.
# Copy to .env (git-ignored). Every chapter runs offline without these;
# keys are only needed for the recorded live-hardware runs.

# =======================================================================
# 1. IBM Quantum Platform  — Open Plan: 10 min QPU / 28 days
#    Create account : https://quantum.cloud.ibm.com/signin
#    API key        : https://cloud.ibm.com/iam/apikeys
#                     (avatar top-right > Manage > Access (IAM) > API keys > Create)
#    Instance CRN   : https://quantum.cloud.ibm.com/instances
#                     (open the Open Plan instance, copy its CRN)
# =======================================================================
QISKIT_IBM_TOKEN=
QISKIT_IBM_CHANNEL=ibm_quantum_platform
QISKIT_IBM_INSTANCE=

# =======================================================================
# 2. IonQ Quantum Cloud  — free account, free simulators up to 29 qubits
#    Create account : https://cloud.ionq.com/auth/create-account
#    API key        : https://cloud.ionq.com/settings/keys
#                     (attach the key to a project when prompted)
# =======================================================================
IONQ_API_KEY=

# =======================================================================
# 3. Amazon Braket  — 1 h/month on-demand simulator, first 12 months
#    AWS account    : https://portal.aws.amazon.com/billing/signup
#    Access keys    : https://console.aws.amazon.com/iam/home#/security_credentials
#    Braket console : https://console.aws.amazon.com/braket/home
#    S3 bucket      : https://s3.console.aws.amazon.com/s3/bucket/create
#                     (name it amazon-braket-<account-id>-<region>)
#    NB: create the IAM user with AmazonBraketFullAccess, not the root account.
# =======================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AMZN_BRAKET_OUT_S3_BUCKET=

# =======================================================================
# 4. Azure Quantum  — new-account credits + per-provider quantum credits
#    Azure signup   : https://azure.microsoft.com/free
#    Subscription ID: https://portal.azure.com/#view/Microsoft_Azure_Billing/SubscriptionsBlade
#    Quantum workspace: https://portal.azure.com/#create/Microsoft.QuantumWorkspace
#                     (note the resource group and workspace name you pick)
#    Credits check  : https://portal.azure.com/#view/Microsoft_Azure_CostManagement/Menu/overview
#    NB: login happens with `az login`; the four values below are identifiers,
#        not secrets. Do not put a client secret here.
# =======================================================================
AZURE_QUANTUM_SUBSCRIPTION_ID=
AZURE_QUANTUM_RESOURCE_GROUP=
AZURE_QUANTUM_WORKSPACE=
AZURE_QUANTUM_LOCATION=westus

# =======================================================================
# 5. D-Wave Leap  — trial: dashboard demos only, NO API token (Nov 2026)
#    Sign up        : https://cloud.dwavesys.com/leap/signup
#    API token      : requires a paid plan; the Trial plan has none.
#    The annealing chapter runs on local dimod + neal simulators instead,
#    and says so in the prose rather than pretending a QPU was used.
# =======================================================================
DWAVE_API_TOKEN=

# =======================================================================
# 6. Quantum Inspire (QuTech)  — free account, real hardware included
#    Sign up        : https://compute.quantum-inspire.com/  (Sign up link)
#                     QI 2.0 accounts live on auth.quantum-inspire.com
#    No API token in QI 2.0. Authenticate once, interactively:
#      .venv/bin/qi login          -> ~/.quantuminspire/config.json
#    The file is read by qiskit-quantuminspire and pennylane-quantuminspire.
# =======================================================================
QUANTUM_INSPIRE_EMAIL=

# =======================================================================
# 7. Optional: qBraid  — one key for IonQ, Rigetti, IQM, AQT + simulators
#    Sign up        : https://account.qbraid.com/register
#    API key        : https://account.qbraid.com/  (Profile > API keys)
# =======================================================================
QBRAID_API_KEY=

# =======================================================================
# Safety rails (read by lib/gateway.py)
# =======================================================================
# 0 = replay recorded runs only; 1 = allow live submissions
QUANTUM_LIVE=0
QUANTUM_MAX_SHOTS=1024
QUANTUM_MAX_TASKS=3
QUANTUM_MAX_SPEND_USD=5
QUANTUM_RUNS_DIR=runs
